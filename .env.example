# Mercenta Commerce — environment template
# Copy to .env.local and fill in. NEVER commit real keys.

# Supabase (browser-safe anon key only; service-role key stays server-side)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OpenRouter (optional — for demo mode only)
# When set, the Integrations wizard will show OpenRouter as auto-connected
# during demo mode, demonstrating a real live integration to investors.
# Get your free API key at https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=

# Hunter.io (optional — for demo mode only)
# When set, the Integrations wizard will show Hunter.io as auto-connected.
# Get your free API key at https://hunter.io/api-keys
VITE_HUNTER_API_KEY=

# Instantly.ai (optional — for demo mode only)
# When set, the Integrations wizard will show Instantly.ai as auto-connected.
# Get your free API key at https://app.instantly.ai/settings/api-keys
VITE_INSTANTLY_API_KEY=

# NOTE: per §14, provider credentials for Amazon SP-API / Stripe / DocuSign /
# Postmark etc. will be managed through the Integrations wizard and stored
# encrypted server-side — they do NOT belong in this file.
