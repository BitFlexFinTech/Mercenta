# Mercenta — Demo Deployment Credentials Template
# Copy to .env.deploy and fill in your real values. Do NOT commit .env.deploy.
# .env.deploy is in .gitignore.
#
# HOW TO USE:
# 1. Copy this file:  cp deploy/credentials.example .env.deploy
# 2. Edit .env.deploy in your own editor — NEVER paste credentials into chat
# 3. Deploy frontend:   npm run deploy
# 4. Deploy services:   bash scripts/deploy-docker.sh

# ── Frontend deploy (SFTP/FTP to demo.mercenta.co.uk) ──────────────
DEPLOY_PROTOCOL=sftp
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
SFTP_REMOTE_PATH=/
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_REMOTE_PATH=/
DEPLOY_DOMAIN=demo.mercenta.co.uk

# ── Self-hosted services VPS (SSH) ─────────────────────────────────
# Used by: bash scripts/deploy-docker.sh && scripts/vps-bootstrap.sh
SSH_HOST=                    # VPS IP address (e.g. 142.93.46.155)
SSH_USER=root                # SSH user (root or sudo-capable)
SSH_KEY_PATH=~/.ssh/id_rsa   # Path to SSH private key
REMOTE_SERVICES_DIR=/opt/mercenta-services

# ── Supabase (optional — empty = pure mock mode) ────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
