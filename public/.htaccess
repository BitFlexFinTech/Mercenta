# Apache rewrite rules for Mercenta SPA
# Serves index.html for all unknown paths so the React SPA can handle routing.
# Existing files (robots.txt, sitemap.xml, etc.) are served directly.

RewriteEngine On

# Don't rewrite existing files or directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Serve index.html for all other paths (SPA routing)
RewriteRule . /index.html [L,QSA]

# ── Compression ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# ── Far-future caching for versioned assets (hash in filename) ──
<FilesMatch "\.(js|css)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# ── Short caching for HTML, JSON, fonts, images ──
<FilesMatch "\.(html|json|woff2?|png|svg|ico|webp)$">
  Header set Cache-Control "public, max-age=86400"
</FilesMatch>

# ── Security headers (§Phase 15 — security launch gate) ──
# Sent by the Apache host for every response. HTTPS itself is enforced at the
# host/domain level (out of the repository's control); these headers harden the
# content the host serves.
<IfModule mod_headers.c>
  # Force HTTPS for this host for one year (per-host; no includeSubDomains/preload).
  Header always set Strict-Transport-Security "max-age=31536000"
  # Never let a browser guess a declared type into a script (MIME sniffing).
  Header always set X-Content-Type-Options "nosniff"
  # Do not leak the full URL to other origins.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # This site is never framed by another origin.
  Header always set X-Frame-Options "SAMEORIGIN"
  # Turn off browser features this site does not use.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
</IfModule>

# Security: Deny access to .env and internal files
<FilesMatch "\.(env|env\.deploy|env\.example|md|log)$">
  Require all denied
</FilesMatch>

# Security: Block directory listing
Options -Indexes